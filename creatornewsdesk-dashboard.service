[Unit]
Description=Creator Newsdesk Dashboard
After=network.target

[Service]
# Owner-private environment file supplies CND_DASHBOARD_TOKEN (32+ random bytes).
EnvironmentFile=/etc/creatornewsdesk/dashboard.env
Type=simple
User=mmurphy
WorkingDirectory=/home/mmurphy/homelab/projects/creatornewsdesk
ExecStart=/usr/bin/python3 /home/mmurphy/homelab/projects/creatornewsdesk/dashboard_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
